{
  "name": "@tnunamak/gozar",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Give a local MCP server an address its client can reach",
  "type": "module",
  "exports": {
    ".": {
      "types": "./packages/gozar-node/route-contract.d.ts",
      "default": "./packages/gozar-node/api.mjs"
    },
    "./service": "./packages/gozar-node/service.mjs",
    "./testing": "./packages/gozar-node/testing.mjs",
    "./bin/gozar.mjs": "./bin/gozar.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/gozar.mjs",
    "packages/gozar-node/*.mjs",
    "packages/gozar-node/*.d.ts",
    "packages/gozar-core/generated/",
    "adapters/**/*.json",
    "adapters/providers/**",
    "runtime/*.json",
    "harness/dummy-server.mjs",
    "docs/service-routes.md",
    "docs/providers.md",
    "LICENSE",
    "examples/",
    "docs/migration-0.4.md",
    "THIRD-PARTY-NOTICES.md",
    "third-party/",
    "docs/release-0.4-license-audit.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tnunamak/gozar.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gozar": "bin/gozar.mjs"
  },
  "scripts": {
    "prepack": "node scripts/check-package.mjs",
    "test:node": "node --test --test-concurrency=1 test/node/*.test.mjs test/adapters/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "types": "./packages/gozar-node/route-contract.d.ts",
  "peerDependencies": {
    "@ngrok/ngrok": "1.7.0"
  },
  "peerDependenciesMeta": {
    "@ngrok/ngrok": {
      "optional": true
    }
  }
}
