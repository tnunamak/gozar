{
  "schemaVersion": 1,
  "definition": {
    "id": "tailscale-private",
    "label": "Tailscale private Serve",
    "audience": "tailnet",
    "ownership": "owned",
    "reason": "Dedicated unused HTTPS listener; existing shared routes stay under their owners.",
    "capabilities": {
      "https": null,
      "sse": null,
      "streamableHttp": null,
      "oauthDcr": null
    },
    "unknowns": [
      "Tailnet HTTPS and requested protocols require genuine remote tailnet instance proof before publication.",
      "HTTPS capability and CertDomains permit provisioning; they do not prove an issued or client-trusted certificate.",
      "Feature setup can prompt despite --yes; closed stdin and bounded startup fail safely when prerequisites are unmet.",
      "Foreground watcher cleanup uses immutable process identity. Remaining or administrator-created mappings remain cleanup debt."
    ],
    "capabilityRecords": [
      {
        "when": "current prerequisites + readback + client-vantage TLS/nonce probe succeed",
        "capabilities": {
          "https": true
        },
        "reasons": [
          "TLS terminates in local tailscaled; no application key export."
        ]
      },
      {
        "when": "timed SSE / HTTP / OAuth probes succeed separately",
        "capabilities": {
          "sse": true,
          "streamableHttp": true,
          "oauthDcr": true
        }
      }
    ],
    "actions": [
      {
        "id": "install",
        "label": "Install Tailscale",
        "reason": "CLI is absent.",
        "url": "https://tailscale.com/download"
      },
      {
        "id": "login",
        "label": "Connect Tailscale",
        "reason": "The daemon is not in Running state.",
        "command": [
          "tailscale",
          "up"
        ],
        "interactive": true
      },
      {
        "id": "https",
        "label": "Enable tailnet HTTPS and MagicDNS",
        "reason": "Requires deliberate administrator action; certificate names enter public logs.",
        "url": "https://login.tailscale.com/admin/dns"
      }
    ],
    "recipes": {
      "detect": {
        "kind": "spawn",
        "program": "tailscale",
        "args": [
          "status",
          "--json",
          "--peers=false"
        ],
        "timeoutMs": 5000,
        "maxOutputBytes": 65536,
        "parser": {
          "kind": "json-document",
          "predicate": {
            "op": "equals",
            "pointer": "/BackendState",
            "value": "Running"
          }
        }
      },
      "create": {
        "kind": "spawn",
        "program": "tailscale",
        "args": [
          "serve",
          "--yes",
          "--https={port}",
          "--set-path={mount}",
          "{loopbackTarget}"
        ],
        "timeoutMs": 20000,
        "maxOutputBytes": 65536,
        "parser": {
          "kind": "exit-code"
        },
        "before": [
          {
            "id": "status",
            "recipe": {
              "kind": "spawn",
              "program": "tailscale",
              "args": [
                "status",
                "--json",
                "--peers=false"
              ],
              "timeoutMs": 5000,
              "maxOutputBytes": 65536,
              "parser": {
                "kind": "json-document",
                "predicate": {
                  "op": "exists",
                  "pointer": ""
                }
              }
            },
            "captures": {
              "dnsName": {
                "type": "dns-name",
                "pointer": "/Self/DNSName",
                "trimTrailingDot": true
              },
              "nodeId": {
                "type": "opaque-ref",
                "pointer": "/Self/ID"
              },
              "tailnetSuffix": {
                "type": "dns-name",
                "pointer": "/CurrentTailnet/MagicDNSSuffix"
              }
            },
            "assert": {
              "op": "all",
              "items": [
                {
                  "op": "equals",
                  "pointer": "/BackendState",
                  "value": "Running"
                },
                {
                  "op": "equals",
                  "pointer": "/CurrentTailnet/MagicDNSEnabled",
                  "value": true
                },
                {
                  "op": "exists",
                  "pointer": "/Self/CapMap/https"
                }
              ]
            }
          },
          {
            "id": "permission",
            "recipe": {
              "kind": "spawn",
              "program": "tailscale",
              "args": [
                "status",
                "--json",
                "--peers=false"
              ],
              "timeoutMs": 5000,
              "maxOutputBytes": 65536,
              "parser": {
                "kind": "json-document",
                "predicate": {
                  "op": "exists",
                  "pointer": ""
                }
              }
            },
            "captures": {},
            "assert": {
              "op": "all",
              "items": [
                {
                  "op": "all",
                  "items": [
                    {
                      "op": "equals",
                      "pointer": "/BackendState",
                      "value": "Running"
                    },
                    {
                      "op": "equals",
                      "pointer": "/CurrentTailnet/MagicDNSEnabled",
                      "value": true
                    },
                    {
                      "op": "exists",
                      "pointer": "/Self/CapMap/https"
                    }
                  ]
                },
                {
                  "op": "equals",
                  "pointer": "/Self/ID",
                  "value": "{nodeId}"
                },
                {
                  "op": "equals",
                  "pointer": "/CurrentTailnet/MagicDNSSuffix",
                  "value": "{tailnetSuffix}"
                },
                {
                  "op": "equals",
                  "pointer": "/CertDomains/*",
                  "value": "{dnsName}"
                }
              ]
            }
          },
          {
            "id": "config",
            "recipe": {
              "kind": "spawn",
              "program": "tailscale",
              "args": [
                "serve",
                "status",
                "--json"
              ],
              "timeoutMs": 5000,
              "maxOutputBytes": 65536,
              "parser": {
                "kind": "json-document",
                "predicate": {
                  "op": "exists",
                  "pointer": ""
                }
              }
            },
            "captures": {
              "occupiedPorts": {
                "type": "port-set",
                "paths": [
                  "/TCP",
                  "/Web",
                  "/AllowFunnel",
                  "/Foreground/*/TCP",
                  "/Foreground/*/Web",
                  "/Foreground/*/AllowFunnel"
                ]
              }
            }
          }
        ],
        "requires": [
          {
            "op": "port-unoccupied",
            "source": "config",
            "pointer": "/occupiedPorts",
            "port": "{port}"
          }
        ],
        "after": [
          {
            "id": "readback",
            "recipe": {
              "kind": "spawn",
              "program": "tailscale",
              "args": [
                "serve",
                "status",
                "--json"
              ],
              "timeoutMs": 5000,
              "maxOutputBytes": 65536,
              "parser": {
                "kind": "json-document",
                "predicate": {
                  "op": "exists",
                  "pointer": ""
                }
              }
            },
            "captures": {
              "route": {
                "type": "record",
                "pointer": "",
                "fields": {
                  "https": {
                    "type": "bool",
                    "pointer": "/Foreground/*/TCP/{port}/HTTPS"
                  },
                  "proxy": {
                    "type": "origin",
                    "pointer": "/Foreground/*/Web/{dnsName}:{port}/Handlers/~1/Proxy"
                  },
                  "funnel": {
                    "type": "bool",
                    "pointer": "/Foreground/*/AllowFunnel/{dnsName}:{port}",
                    "optional": true
                  }
                }
              },
              "selectedListener": {
                "type": "record",
                "pointer": "/Foreground/*/TCP/{port}",
                "fields": {}
              },
              "selectedWeb": {
                "type": "record",
                "pointer": "/Foreground/*/Web/{dnsName}:{port}",
                "fields": {}
              }
            },
            "assert": {
              "op": "all",
              "items": [
                {
                  "op": "equals",
                  "pointer": "/Foreground/*/TCP/{port}",
                  "value": {
                    "HTTPS": true
                  }
                },
                {
                  "op": "equals",
                  "pointer": "/Foreground/*/Web/{dnsName}:{port}",
                  "value": {
                    "Handlers": {
                      "/": {
                        "Proxy": "{loopbackTarget}"
                      }
                    }
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/Foreground/*/AllowFunnel/{dnsName}:{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/TCP/{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/Web/{dnsName}:{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/AllowFunnel/{dnsName}:{port}"
                  }
                }
              ]
            }
          }
        ],
        "ledger": {
          "https": true,
          "proxy": "{loopbackTarget}",
          "funnel": null
        },
        "process": {
          "mode": "owned-long-running",
          "stdin": "closed",
          "lifetimeMs": 86400000,
          "collectMs": 2000
        }
      },
      "remove": {
        "kind": "owned-process",
        "signal": "SIGTERM",
        "graceMs": 2000,
        "thenSignal": "SIGKILL",
        "confirmExit": true,
        "timeoutMs": 10000,
        "maxOutputBytes": 65536,
        "parser": {
          "kind": "exit-code"
        },
        "before": [
          {
            "id": "identity",
            "recipe": {
              "kind": "spawn",
              "program": "tailscale",
              "args": [
                "status",
                "--json",
                "--peers=false"
              ],
              "timeoutMs": 5000,
              "maxOutputBytes": 65536,
              "parser": {
                "kind": "json-document",
                "predicate": {
                  "op": "exists",
                  "pointer": ""
                }
              }
            },
            "captures": {},
            "assert": {
              "op": "all",
              "items": [
                {
                  "op": "equals",
                  "pointer": "/BackendState",
                  "value": "Running"
                },
                {
                  "op": "equals",
                  "pointer": "/Self/ID",
                  "value": "{nodeId}"
                },
                {
                  "op": "equals",
                  "pointer": "/CurrentTailnet/MagicDNSSuffix",
                  "value": "{tailnetSuffix}"
                }
              ]
            }
          }
        ],
        "requires": [],
        "after": [
          {
            "id": "readback",
            "recipe": {
              "kind": "spawn",
              "program": "tailscale",
              "args": [
                "serve",
                "status",
                "--json"
              ],
              "timeoutMs": 5000,
              "maxOutputBytes": 65536,
              "parser": {
                "kind": "json-document",
                "predicate": {
                  "op": "exists",
                  "pointer": ""
                }
              }
            },
            "captures": {
              "route": {
                "type": "record",
                "pointer": "/Web/{dnsName}:{port}",
                "fields": {},
                "optional": true
              }
            },
            "assert": {
              "op": "all",
              "items": [
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/TCP/{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/Web/{dnsName}:{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/AllowFunnel/{dnsName}:{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/Foreground/*/TCP/{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/Foreground/*/Web/{dnsName}:{port}"
                  }
                },
                {
                  "op": "not",
                  "predicate": {
                    "op": "exists",
                    "pointer": "/Foreground/*/AllowFunnel/{dnsName}:{port}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "admission": {
      "state": "admitted",
      "requiredFeatures": [
        "recipe-sequence",
        "typed-bindings",
        "predicate-parser",
        "owned-resource-ledger",
        "owned-process",
        "probe-assertions",
        "client-vantage-probe",
        "unused-port-selection"
      ],
      "reason": "Normalized opt-in plan only; both core and host feature intersection and fresh authorities must pass. Wrapper is not auto-admitted."
    },
    "validation": {
      "tls": "client-trusted certificate and exact hostname when HTTPS",
      "instanceNonce": "must equal private instance challenge",
      "sse": "timed incremental event delivery when required",
      "vantage": "tailnet",
      "publish": "exact-origin approval only after all required probes"
    },
    "lifecycle": {
      "persistIntentBeforeMutation": true,
      "completionScope": [
        "effectId",
        "sessionId",
        "generation"
      ],
      "rawOutput": "transient bounded; never persist",
      "stop": "withdraw before cleanup; reconcile uncertain effects",
      "globalCleanup": false,
      "ownershipFields": [
        "nodeId",
        "tailnetSuffix",
        "dnsName",
        "port",
        "mount",
        "loopbackTarget"
      ],
      "ledgerDetails": {
        "https": true,
        "proxy": "{loopbackTarget}",
        "funnel": null
      },
      "identitySemantics": "Current node (Self.ID) plus the tailnet DNS suffix fingerprint; not a native Tailscale profile ID. The tailnet StableID is not used: Tailscale 1.102.5 does not report it.",
      "cleanup": "Stop only immutable owned foreground process; watcher releases its own session; confirm exact port absent. Any remaining mapping is cleanup debt, never global reset/off."
    },
    "detection": {
      "steps": [
        {
          "id": "status",
          "recipe": {
            "kind": "spawn",
            "program": "tailscale",
            "args": [
              "status",
              "--json",
              "--peers=false"
            ],
            "timeoutMs": 5000,
            "maxOutputBytes": 65536,
            "parser": {
              "kind": "json-document",
              "predicate": {
                "op": "equals",
                "pointer": "/BackendState",
                "value": "Running"
              }
            }
          }
        },
        {
          "id": "config",
          "recipe": {
            "kind": "spawn",
            "program": "tailscale",
            "args": [
              "serve",
              "status",
              "--json"
            ],
            "timeoutMs": 5000,
            "maxOutputBytes": 65536,
            "parser": {
              "kind": "json-document",
              "predicate": {
                "op": "exists",
                "pointer": ""
              }
            }
          }
        }
      ],
      "installed": "spawn success distinguishes CLI presence only",
      "login": {
        "predicate": {
          "op": "equals",
          "source": "stdout",
          "pointer": "/BackendState",
          "value": "Running"
        },
        "otherwise": "NeedsLogin, NeedsMachineAuth, daemon unavailable, and malformed output are distinct"
      },
      "permission": "Running, MagicDNSEnabled, source-backed HTTPS capability key and exact CertDomains membership permit setup; issued TLS and tailnet reach are established only by the probe.",
      "neverProbeByMutation": true
    },
    "bindings": {
      "port": {
        "type": "unused-port",
        "source": "config",
        "pointer": "/occupiedPorts",
        "candidates": [
          9444,
          9445
        ],
        "protectedPorts": [
          443,
          10000
        ]
      },
      "mount": {
        "type": "mount",
        "value": "/"
      },
      "loopbackTarget": {
        "type": "loopback-http-origin"
      },
      "dnsName": {
        "type": "dns-name",
        "source": "status",
        "pointer": "/dnsName"
      },
      "nodeId": {
        "type": "opaque-private-reference",
        "source": "status",
        "pointer": "/nodeId"
      },
      "tailnetSuffix": {
        "type": "dns-name",
        "source": "status",
        "pointer": "/tailnetSuffix"
      }
    },
    "endpointTemplate": "https://{dnsName}:{port}",
    "safety": {
      "protectedPorts": [
        443,
        10000,
        8444,
        9443
      ],
      "fallbackPort": null,
      "dedicatedPortRequired": true,
      "restoreWholeConfig": false,
      "nativeOwnerMarker": false,
      "identicalExternalRecreation": "cannot distinguish without exclusive ownership; stop and reconcile if ownership continuity is uncertain",
      "busy": "stop without mutation",
      "funnelVisibility": "host:port-wide; never enable public visibility; preserve every occupied listener",
      "rootMountRequiresDedicatedUnusedPort": true,
      "candidatePorts": [
        9444,
        9445
      ],
      "preserveAnyOccupiedPort": true,
      "continuity": "Fresh driver ownershipReceipt required; CLI values and ETag are not continuity or compare-and-swap proof.",
      "cleanupStrategy": "owned foreground watcher process; no Serve/Funnel off/reset",
      "identity": "node/tailnet fingerprint, never fabricated profileId"
    },
    "planVersion": 1,
    "drop": "1",
    "displayName": "Private tailnet HTTPS",
    "copy": {
      "consent": "Start an owned foreground private HTTPS listener on an unused 9444 or 9445 only. Existing listeners stay untouched. Verify TLS, instance identity and requested protocols from a tailnet client before publication.",
      "human": {
        "name": "tailscale-private",
        "address": "https://<machine>.<tailnet>.ts.net",
        "summary": "private HTTPS inside your Tailscale network",
        "setup": "Install Tailscale and sign in"
      }
    },
    "addressStability": "stable",
    "durableLifetime": "provider-persistent",
    "idleTimeoutMs": null,
    "providerResource": "tailscale-https-port",
    "durableRecipe": {
      "transport": "tailscale-localapi-serve-config",
      "mode": "serve",
      "candidatePorts": [
        443,
        8443,
        10000
      ],
      "portsFromCapability": null,
      "listener": {
        "tcp": {
          "HTTPS": true
        },
        "web": {
          "Handlers": {
            "/": {
              "Proxy": "http://{target}"
            }
          }
        },
        "funnel": null
      }
    },
    "durableAdoptOnlyPorts": [
      9443
    ]
  }
}
