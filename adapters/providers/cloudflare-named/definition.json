        "metadataVisibleTo": [
          "Cloudflare edge"
        ],
        "evidenceRef": "https://www.cloudflare.com/plans/sase-zero-trust.md (accessed 2026-11-12) ; https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/ (accessed 2026-11-12)"
      },
      "address": {
        "stability": "stable",
        "scope": "hostname route in the owner\u2019s Cloudflare account",
        "conditions": [
          "the existing tunnel service mapping must point to the configured local gate port",
          "DNS and the tunnel come from managed setup or an existing owner-managed configuration"
        ],
        "ports": null
      },
      "cost": {
        "kind": "unknown",
        "summary": "Cloudflare lists a $0 Free Zero Trust plan with connector software included, but no page names Cloudflare Tunnel.",
