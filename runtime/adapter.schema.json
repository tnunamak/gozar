{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnunamak/gozar/runtime/adapter.schema.json",
  "title": "Gozar adapter definition v1",
  "description": "Properties, Reach and Disclosure are copies of the route-catalog.schema.json definitions; a test checks they stay equal.",
  "$defs": {
    "AdapterDefinition": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "label",
        "capabilities",
        "supportedKinds",
        "disclosure"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/Properties"
        },
        "supportedKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "session",
              "attached",
              "durable"
            ]
          }
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        },
        "needs": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ProviderEntry": {
      "type": "object",
      "required": [
        "id",
        "module",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Properties": {
      "type": "object",
      "required": [
        "reach",
        "transport",
        "traffic",
        "address",
        "cost",
        "needsAccount",
        "lifetimes",
        "supervision",
        "protocols"
      ],
      "properties": {
        "reach": {
          "$ref": "#/$defs/Reach"
        },
        "transport": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "traffic": {
          "type": "object",
          "required": [
            "tlsTermination",
            "providerCanReadPayload",
            "readers",
            "metadataVisibleTo",
            "evidenceRef"
          ],
          "properties": {
            "tlsTermination": {
              "type": "string",
              "enum": [
                "endpoint",
                "provider",
                "unknown"
              ]
            },
            "providerCanReadPayload": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "readers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "metadataVisibleTo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidenceRef": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "address": {
          "type": "object",
          "required": [
            "stability",
            "scope",
            "conditions"
          ],
          "properties": {
            "stability": {
              "type": "string",
              "enum": [
                "stable",
                "ephemeral",
                "unknown"
              ]
            },
            "scope": {
              "type": "string"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ports": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "required": [
            "kind",
            "summary",
            "currency",
            "amount",
            "period"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "free",
                "paid",
                "unknown"
              ]
            },
            "summary": {
              "type": "string"
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "period": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "needsAccount": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lifetimes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "session",
              "attached",
              "durable"
            ]
          }
        },
        "supervision": {
          "type": "string",
          "enum": [
            "controller",
            "provider-persistent",
            "host-supervised"
          ]
        },
        "protocols": {
          "type": "object",
          "required": [
            "sse",
            "streamableHttp",
            "oauthDcr"
          ],
          "properties": {
            "sse": {
              "type": "boolean"
            },
            "streamableHttp": {
              "type": "boolean"
            },
            "oauthDcr": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "proof": {
          "type": "object",
          "required": [
            "vantage",
            "checks"
          ],
          "properties": {
            "vantage": {
              "type": "string",
              "enum": [
                "public",
                "tailnet",
                "lan",
                "this-device",
                "none"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "tls",
                  "nonce",
                  "sse"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Reach": {
      "type": "string",
      "enum": [
        "internet",
        "tailnet",
        "lan",
        "this-device",
        "unknown"
      ]
    },
    "Disclosure": {
      "type": "object",
      "required": [
        "revision",
        "text",
        "links"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rel",
              "label",
              "href"
            ],
            "properties": {
              "rel": {
                "type": "string",
                "enum": [
                  "terms",
                  "privacy"
                ]
              },
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "AdapterPlan": {
      "type": "object",
      "required": [
        "digest",
        "origin",
        "resourceKey",
        "effects",
        "readback",
        "cleanup",
        "precondition"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "resourceKey": {
          "type": "string"
        },
        "effects": {
          "type": "array"
        },
        "readback": {},
        "cleanup": {},
        "precondition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "revision"
              ],
              "properties": {
                "revision": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "adapterId",
        "resourceKey",
        "generation",
        "identity",
        "readback",
        "origin"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "adapterId": {
          "type": "string"
        },
        "resourceKey": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "identity": {},
        "readback": {},
        "origin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "AdapterEffectError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "precondition_failed",
            "unsupported",
            "provider_unavailable",
            "setup_required"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
